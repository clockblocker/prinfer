{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"declaration": true,
		"declarationMap": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"lib": ["ES2022"],
		"types": ["bun-types"]
	},
	"include": ["src/**/*"],
	"exclude": [
		"node_modules",
		"dist",
		"src/__tests__/fixtures/diagnostics",
		"src/__tests__/fixtures/custom-project"
	]
}
