{
	"name": "typeprobe",
	"version": "3.4.0",
	"mcpName": "io.github.clockblocker/typeprobe",
	"description": "TypeScript inferred types, completions and type errors for AI coding agents and type tests: an MCP server, a CLI, and snapshot-test helpers",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./vitest": {
			"import": {
				"types": "./dist/vitest.d.ts",
				"default": "./dist/vitest.js"
			},
			"require": {
				"types": "./dist/vitest.d.cts",
				"default": "./dist/vitest.cjs"
			}
		},
		"./testing": {
			"import": {
				"types": "./dist/testing.d.ts",
				"default": "./dist/testing.js"
			},
			"require": {
				"types": "./dist/testing.d.cts",
				"default": "./dist/testing.cjs"
			}
		}
	},
	"bin": {
		"typeprobe": "dist/cli.js",
		"typeprobe-mcp": "dist/mcp.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "bun run tsup",
		"bench:runtime": "bun run build && node benchmarks/runtime.mjs",
		"typecheck": "bunx tsc --noEmit",
		"test": "bun test",
		"ci": "bun run typecheck && bun run build && bunx biome check . && bun test",
		"changeset": "changeset",
		"version": "changeset version && node scripts/sync-server-json.mjs",
		"release": "bun run build && changeset publish",
		"mcpb": "bun run build && bunx @anthropic-ai/mcpb@2.1.2 validate mcpb/manifest.json && node scripts/pack-mcpb.mjs",
		"shim:pack": "npm pack ./shim/prinfer",
		"prepublishOnly": "bun run ci",
		"prepare": "simple-git-hooks"
	},
	"simple-git-hooks": {
		"pre-commit": "bunx biome check ."
	},
	"keywords": [
		"mcp",
		"mcp-server",
		"model-context-protocol",
		"ai",
		"agent",
		"claude",
		"claude-code",
		"codex",
		"cursor",
		"llm",
		"typescript",
		"type-inference",
		"types",
		"hover",
		"lsp",
		"inspection",
		"cli",
		"testing",
		"type-testing",
		"snapshot",
		"type-tests",
		"prinfer"
	],
	"author": "",
	"license": "MIT",
	"homepage": "https://clockblocker.github.io/typeprobe/",
	"bugs": {
		"url": "https://github.com/clockblocker/typeprobe/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/clockblocker/typeprobe.git"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@changesets/cli": "^2.29.8",
		"bun-types": "latest",
		"simple-git-hooks": "^2.13.1",
		"tsup": "^8.0.0"
	},
	"engines": {
		"bun": ">=1.0.0",
		"node": ">=20.0.0"
	},
	"dependencies": {
		"@modelcontextprotocol/server": "^2.0.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"typescript": "^6.0.3",
		"zod": "^4.3.6"
	}
}
